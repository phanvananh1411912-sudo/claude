  "ambiguous": {
    "阝": {
      "note": "Ký tự U+961D dùng cho cả hai. Phân biệt theo VỊ TRÍ trong chuỗi decomposition (IDS):",
      "left": "阜",
      "right": "邑",
      "rule": "Trong IDS ⿰A B: nếu 阝 là A (bên trái) -> 阜 (gò đất 🏔️); nếu là B (bên phải) -> 邑 (thành ấp 🏘️)."
    },
    "月": {
      "note": "月 bên trái của chữ chỉ bộ phận cơ thể thực chất là 肉 (thịt).",
      "default": "月",
      "as_flesh": "肉",
      "rule": "Nếu makemeahanzi/etymology.hint có 'flesh' hoặc chữ thuộc nhóm cơ thể (肝 gan, 腿 chân, 脸 mặt, 胖 béo...) -> map sang 肉 🥩; còn lại giữ 月 🌙. Cách đơn giản: ưu tiên trường 'semantic' trong makemeahanzi vì nó đã ghi đúng 肉 cho các chữ này."
    },
    "王": {
      "note": "王 đứng bên trái chữ thường là biến thể của 玉 (ngọc): 玩, 珍, 球...",
      "default": "王",
      "as_jade": "玉",
      "rule": "Nếu 王 ở vị trí trái trong IDS ⿰ -> map 玉 💎."
    }
  },
  "fallback": {
    "rule": "Thành phần không có trong 'radicals' và 'variants' -> hiển thị chính chữ thành phần trong khung tròn, kèm pinyin nếu tra được từ makemeahanzi. Không được bỏ trống.",
